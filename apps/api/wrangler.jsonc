{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rifas-app",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Frontend estático (build de apps/web) servido por el mismo Worker.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Tareas programadas (se implementan en fases posteriores).
  "triggers": { "crons": ["*/10 * * * *"] },

  "observability": { "enabled": true },

  // Base de datos de producción (ya creada, con las migraciones 0001 y 0002 aplicadas).
  // En local (dev y pruebas) se usa una base SQLite simulada; el id no se usa.
  // Migraciones futuras: `pnpm exec wrangler d1 migrations apply rifas-db --remote` (desde apps/api).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rifas-db",
      "database_id": "9d191629-ea37-405d-9a42-4dad1056a4c5",
      "migrations_dir": "../../migrations"
    }
  ]
  // Pendiente (Fase 2+): dominio personalizado
  // "routes": [{ "pattern": "turifa.capitalfinaura.com", "custom_domain": true }]
}
