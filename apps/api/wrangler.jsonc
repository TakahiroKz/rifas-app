{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rifas-app",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Frontend estático (build de apps/web) servido por el mismo Worker.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /r/* pasa por el Worker para añadir la vista previa del enlace (título y descripción de la rifa).
    "run_worker_first": ["/api/*", "/r/*"]
  },

  // Tareas programadas (se implementan en fases posteriores).
  // Dos tareas: cada 10 min (apartados vencidos, resultados, limpieza) y el respaldo diario a las 08:00 UTC
  // (03:00 en Colombia). El segundo debe coincidir con BACKUP_CRON en src/jobs/backup.ts.
  "triggers": { "crons": ["*/10 * * * *", "0 8 * * *"] },

  // Solo se sirve por el dominio propio; sin URL *.workers.dev ni de vista previa.
  "workers_dev": false,
  "preview_urls": false,

  "observability": { "enabled": true },

  // Turnstile (anti-bots) al apartar. El secreto NO va aquí: `wrangler secret put TURNSTILE_SECRET`.
  // La clave pública se obtiene al crear el widget en Cloudflare → Turnstile (hostname turifa.capitalfinaura.com).
  // Mientras no esté configurada, apartar responde 503 (falla cerrado).
  "vars": {
    "REQUIRE_TURNSTILE": "true",
    "TURNSTILE_SITE_KEY": "",
    // Consulta automática de resultados a Gane. Déjala en "false" hasta tener su autorización por escrito;
    // mientras tanto el resultado se ingresa a mano en el panel.
    "LOTTERY_SYNC_ENABLED": "false"
  },

  // Límite de tasa por IP al apartar: 20 solicitudes por minuto.
  "ratelimits": [
    { "name": "RESERVE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],

  // Base de datos de producción (ya creada, con las migraciones 0001 a 0004 aplicadas).
  // En local (dev y pruebas) se usa una base SQLite simulada; el id no se usa.
  // Migraciones futuras: `pnpm exec wrangler d1 migrations apply rifas-db --remote` (desde apps/api).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rifas-db",
      "database_id": "9d191629-ea37-405d-9a42-4dad1056a4c5",
      "migrations_dir": "../../migrations"
    }
  ],

  // Dominio: al desplegar, Cloudflare crea el registro DNS y el certificado de este subdominio
  // (la zona capitalfinaura.com ya está en tu cuenta). app.capitalfinaura.com es de otro Worker.
  "routes": [{ "pattern": "turifa.capitalfinaura.com", "custom_domain": true }],

  // Respaldos diarios. R2 todavía no está habilitado en la cuenta: actívalo en el panel de Cloudflare,
  // crea el bucket con `wrangler r2 bucket create rifas-backups` y descomenta este bloque.
  // Mientras tanto el respaldo se omite sin error.
  // "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "rifas-backups" }],

  // Entorno de pruebas automáticas (vitest): sin Turnstile ni límite de tasa para no interferir;
  // ambos se prueban aparte. Los enlaces (bindings) no se heredan, por eso se repite D1.
  "env": {
    "test": {
      // Solo para pruebas: nunca debe tomar el dominio ni las tareas programadas del Worker real.
      "routes": [],
      "triggers": { "crons": [] },
      // Bucket simulado: en pruebas no es de verdad.
      "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "rifas-backups-test" }],
      "vars": {
        "REQUIRE_TURNSTILE": "false",
        "TURNSTILE_SITE_KEY": "",
        "LOTTERY_SYNC_ENABLED": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rifas-db",
          "database_id": "9d191629-ea37-405d-9a42-4dad1056a4c5",
          "migrations_dir": "../../migrations"
        }
      ]
    }
  }
}
